{
	"name": "noksito",
	"module": "index.ts",
	"type": "module",
	"private": false,
	"description": "A discord bot to monitor your services",
	"scripts": {
		"start:dev": "bun run --watch src/index.ts",
		"start:prod": "bun run dist/index.js",
		"build": "bun build ./src/index.ts --outdir ./dist --target bun --minify",
		"format": "bunx --bun @biomejs/biome check --write"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.14",
		"@types/bun": "latest"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"seyfert": "^4.3.0"
	}
}
